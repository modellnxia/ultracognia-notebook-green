API_KEY=1234
ENV=local
BACKUP_SCHEDULE_HOUR=23
BACKUP_SCHEDULE_MINUTE=50
DATABASE_URL=url
NOTEBOOKLM_AUTH_JSON=auth_json
# Modo master-token (auto-renovação de sessão, evita depender de relogin manual):
# ⚠️ NOTEBOOKLM_AUTH_JSON acima NÃO pode estar setada junto com este modo —
# são mutuamente exclusivos nessa versão da lib (ver README, seção Deploy).
NOTEBOOKLM_MASTER_TOKEN_JSON=master_token_json
NOTEBOOKLM_REFRESH_CMD=notebooklm login --master-token-refresh
OUTPUT_DIR=./outputs
SLIDE_DECK_INSTRUCTION=Crie apenas um artefato utilizando todos os sources disponiveis
SYSTEM_PROMPT=Analise os materiais com profundidade e estruture as respostas de forma clara.
USE_MOCK_REPORT=true
ENV=prod

# ── Gerador de slides (app/decks/) ──────────────────────────────────────────
GEMINI_API_KEY=gemini_api_key
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=supabase_service_role_key
# Teto de custo por job (centavos de dólar) — disjuntor que aborta o resto do
# job se o gasto acumulado passar disso. Default: 500 (US$ 5,00).
DECK_JOB_MAX_COST_CENTS=500
# Modelo de imagem do Gemini ("Nano Banana"). Default: gemini-3.1-flash-image.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Provider de geração de imagem: gemini (exige billing habilitado no Google
# Cloud), openai (API de imagens da OpenAI, gpt-image-1 — exige billing
# habilitado no projeto OpenAI) ou openrouter (endpoint dedicado de imagem
# do OpenRouter, /api/v1/images). Ver app/decks/llm/images.py. Default: gemini.
DECK_IMAGE_PROVIDER=gemini
OPENAI_API_KEY=openai_api_key
# Qualidade da imagem gerada pela OpenAI: low | medium | high | auto.
# Default: high (a mais alta disponível).
OPENAI_IMAGE_QUALITY=high
# Modelo de imagem da OpenAI. Default: gpt-image-1.
OPENAI_IMAGE_MODEL=gpt-image-1
# Chave do OpenRouter — usada tanto pro texto (llm/client.py, tabela
# `providers`) quanto pra imagem (llm/images.py, endpoint /api/v1/images).
# Reativado no combo em 2026-08-27 (chave nova do cliente, validada).
OPENROUTER_API_KEY=openrouter_api_key
# Modelo de imagem do OpenRouter. Default: google/gemini-2.5-flash-image.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Theme Library (2026-08-24) — segunda chave, além do x-api-key global, só
# pros endpoints de administração de tema (POST/GET /decks/themes, header
# X-Theme-Admin-Key). Sem isso configurado, essas rotas ficam fechadas
# (503) mesmo com o x-api-key certo — não tem valor default de propósito.
DECKS_THEME_ADMIN_KEY=deck_theme_admin_key
